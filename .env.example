# Receipt reading (Gemini 2.0 Flash).
# Get a key at https://aistudio.google.com/apikey — free tier is enough for this.
# Without this the app runs a clearly labelled mock reader and still demos end to end.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# Neon Postgres. https://console.neon.tech -> New Project -> pooled connection string.
DATABASE_URL=

# 32+ random bytes, base64. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
